# Exemplo de variaveis de ambiente para a API.
# Copie para .env e ajuste conforme necessario. NAO commit .env (esta no .gitignore).

# Token HuggingFace (necessario apenas para modelos gated, ex: FLUX.1-dev).
# Para FLUX.1-schnell e SDXL (Apache-2.0) pode ficar vazio.
HF_TOKEN=

# Pasta de cache dos pesos (montada como volume no compose).
HF_HOME=/models

# Repositorios dos modelos (sobrescreva se quiser outros).
MODEL_A_REPO=black-forest-labs/FLUX.1-schnell
MODEL_B_REPO=stabilityai/stable-diffusion-xl-base-1.0

# Padroes de geracao.
DEFAULT_NUM_STEPS=4
DEFAULT_SEED=42
TORCH_DTYPE=bfloat16
OUTPUT_DIR=/app/output
